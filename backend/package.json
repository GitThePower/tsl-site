{
  "name": "tsl-site",
  "version": "2.0.5",
  "bin": {
    "tsl-site": "bin/app.ts"
  },
  "scripts": {
    "build": "tsc",
    "cdk": "cdk",
    "cleanup": "@powershell -NoProfile -ExecutionPolicy Unrestricted -Command ./cleanUp.ps1",
    "deploy": "tsc && node -r ts-node/register --test test/stack.test.ts && cdk synth && cdk deploy --require-approval never && npm run cleanup",
    "test": "node -r ts-node/register --test \"test/**/*.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GitThePower/tsl-site.git"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.0.0",
    "@types/node": "^24.0.0",
    "@types/uuid": "^10.0.0",
    "aws-cdk": "^2.1149.0",
    "aws-cdk-lib": "^2.278.0",
    "constructs": "^10.0.0",
    "esbuild": "^0.25.0",
    "ts-node": "^10.0.0",
    "typescript": "~5.8.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-secrets-manager": "^3.1032.0",
    "@aws-sdk/util-dynamodb": "^3.0.0",
    "uuid": "^11.0.0",
    "zod": "^4.6.7"
  }
}
